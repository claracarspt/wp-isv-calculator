{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "claracars/isv-calculator",
  "version": "1.0.0",
  "title": "Clara Cars ISV & IUC Calculator",
  "category": "widgets",
  "icon": "calculator",
  "description": "Free Portuguese car-tax calculator — ISV (import tax) + IUC (annual road tax). Maintained estimate, open source.",
  "keywords": ["isv", "iuc", "portugal", "car tax", "calculator"],
  "textdomain": "claracars-isv-calculator",
  "editorScript": "file:./block.js",
  "supports": {
    "html": false
  },
  "attributes": {
    "lang": { "type": "string", "default": "pt" },
    "height": { "type": "number", "default": 480 }
  }
}
